# Copy to .env and fill in. Wrap values containing $ or spaces in 'single quotes'.

# --- Household login (required) ---------------------------------------------
# A 6-digit PIN, e.g. APP_PIN=482913. Changing it logs everyone out.
APP_PIN=
# Random secret for signing session cookies (at least 32 bytes). Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=

# --- Cookidoo (optional: leave blank to hide the Cookidoo buttons) ----------
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=
COOKIDOO_COUNTRY=gb
COOKIDOO_LANGUAGE=en-GB

# --- Pantry Tracker (optional, read-only) ------------------------------------
# Items in stock there drop off the shopping list. On the NAS use its LAN
# address, not localhost, e.g. http://192.168.1.20:1683
PANTRY_URL=

# --- Meal photos from Pexels (optional) ----------------------------------------
# Free key from https://www.pexels.com/api/ . Meals without a photo get one automatically.
PEXELS_API_KEY=

# --- Storage -----------------------------------------------------------------
DB_PATH=/data/shop.db

# --- Synology user/group that owns /volume1/docker/weekly-shop/data -----------
# Find them over SSH with:  id <your-dsm-username>
PUID=1026
PGID=100
